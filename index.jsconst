const questions = [
    { q: "7, 26, 63, 124, ? Keyingi sonni toping.", a: ["215", "217", "210"], c: 0 },
    { q: "Finger is to Hand bo'lsa, Leaf is to ...", a: ["Tree", "Twig", "Flower"], c: 1 },
    { q: "1, 1, 2, 3, 5, 8, 13, ? Keyingi sonni toping.", a: ["18", "21", "25"], c: 1 },
    { q: "Qaysi biri guruhga kirmaydi?", a: ["Olma", "Nok", "Mashina"], c: 2 }
    // Videodagi qolgan savollarni ham shu formatda qo'shish mumkin
];

let currentQ = 0;
let score = 0;
let timeLeft = 120;
let timer;

function startQuiz() {
    document.getElementById('start-screen').classList.add('hidden');
    document.getElementById('quiz-screen').classList.remove('hidden');
    showQuestion();
    startTimer();
}

function startTimer() {
    timer = setInterval(() => {
        timeLeft--;
        let min = Math.floor(timeLeft / 60);
        let sec = timeLeft % 60;
        document.getElementById('time').innerText = `${min}:${sec < 10 ? '0'+sec : sec}`;
        if(timeLeft <= 0) finishQuiz();
    }, 1000);
}

function showQuestion() {
    let q = questions[currentQ];
    document.getElementById('q-text').innerText = q.q;
    document.getElementById('q-num').innerText = currentQ + 1;
    let optDiv = document.getElementById('q-options');
    optDiv.innerHTML = "";
    q.a.forEach((opt, i) => {
        optDiv.innerHTML += `<button class="opt-btn" onclick="checkAnswer(${i})">${opt}</button>`;
    });
}

function checkAnswer(idx) {
    if(idx === questions[currentQ].c) score += 15;
    currentQ++;
    if(currentQ < questions.length) showQuestion();
    else finishQuiz();
}

function finishQuiz() {
    clearInterval(timer);
    document.getElementById('quiz-screen').classList.add('hidden');
    document.getElementById('result-screen').classList.remove('hidden');
    document.getElementById('final-iq').innerText = 80 + score;
    document.getElementById('iq-msg').innerText = score > 40 ? "Siz dahosiz!" : "Yaxshi natija!";
}
	
